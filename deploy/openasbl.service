[Unit]
Description=OpenASBL Gunicorn Daemon
After=network.target

[Service]
User=openasbl
Group=www-data
WorkingDirectory=/opt/openasbl
Environment="OPENASBL_RUNTIME_MODE=server"
Environment="DJANGO_DEBUG=False"
Environment="DJANGO_SECRET_KEY=__SECRET_KEY__"
Environment="DJANGO_ALLOWED_HOSTS=__DOMAIN__"
Environment="OPENASBL_BIND=127.0.0.1:__PORT__"
# Le compte de service n'a pas de dossier personnel et ProtectHome rend /home
# inaccessible : Gunicorn a besoin d'un HOME inscriptible pour son serveur de
# contrôle. systemd crée et nettoie /run/openasbl automatiquement.
RuntimeDirectory=openasbl
Environment="HOME=/run/openasbl"
ExecStart=/opt/openasbl/venv/bin/gunicorn openasbl.wsgi:application -c /opt/openasbl/deploy/gunicorn.conf.py
Restart=on-failure
RestartSec=5

# Cloisonnement : le VPS héberge d'autres services.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
